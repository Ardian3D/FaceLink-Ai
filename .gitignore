# =============================================================================
# .gitignore — FaceLink AI
# Tugas: FL-001 (Fondasi Repository dan Dokumentasi)
# Tujuan: mencegah kode build, berkas lokal, RAHASIA, serta DATA BIOMETRIK/pribadi
#         masuk ke riwayat Git. Lihat docs/SECURITY_PRIVACY.md dan
#         docs/COLLABORATION.md bagian 5.
#
# PENTING: dokumentasi (`*.md`, `docs/`, `research/`) dan source code yang akan
# dibuat pada fase berikutnya TIDAK boleh diabaikan oleh berkas ini.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. RAHASIA DAN KONFIGURASI LOKAL (paling kritis)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.envrc

# Rahasia perangkat, kunci, dan token yang diprovisikan saat demo
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
secret/
credentials/
credentials.json
service-account*.json
*.token
device-tokens.json
operator-tokens.json

# -----------------------------------------------------------------------------
# 2. DATA BIOMETRIK DAN PRIBADI — TIDAK BOLEH MASUK REPOSITORY
#    (docs/SECURITY_PRIVACY.md, docs/COLLABORATION.md bagian 5)
# -----------------------------------------------------------------------------
# Sampel enrollment dan penangkapan wajah
data/enrollment/
data/captures/
data/frames/
data/faces/
data/biometric/
data/participants/
enrollment/
captures/
faces/
samples/
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.tiff

# Embedding / template biometrik
*.npy
*.npz
*.pkl
*.pickle
*.emb
embeddings/
templates/
*.face
*.faceenc

# Ekspor dan database pribadi
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.db-wal2
*.mdb
*.dump
*.sql.gz
backups/
*.backup

# Dikecualikan: gambar dokumentasi/skema yang benar-benar berizin dan sintetis
!docs/**/*.png
!docs/**/*.svg
!docs/**/*.jpg

# -----------------------------------------------------------------------------
# 3. MODEL AI LOKAL (besar, lisensi berkas harus ditinjau sebelum di-commit)
#    docs/FACE_ENGINE.md & docs/REFERENCES.md mensyaratkan versi + checksum.
# -----------------------------------------------------------------------------
models/
models-cache/
weights/
*.onnx
*.tflite
*.caffemodel
*.weights
*.pt
*.pth
*.h5
*.pb
*.bin
*.param
.sface/
.yunet/
checkpoints/

# -----------------------------------------------------------------------------
# 4. Go
# -----------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
/vendor/
go.work
go.work.sum
coverage.out
coverage.html
*.prof
__debug_bin*
delv-*

# -----------------------------------------------------------------------------
# 5. Python (mesin AI lokal)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.hypothesis/
site/

# -----------------------------------------------------------------------------
