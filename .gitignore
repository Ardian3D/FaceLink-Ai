# -----------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Expo
.expo/
.expo-shared/
expo-env.d.ts
*.orig.*
*.p8
*.mobileprovision
*.mobileprovision.*
android/app/*.keystore
android/app/debug.keystore
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.cxx/
ios/Pods/
ios/build/
