ios/*.xcodeproj/xcuserdata/
ios/.xcode.env.local
metro-cache/
.cache/

# -----------------------------------------------------------------------------
# 7. Firmware ESP32 (fase hardware, docs/DEVICE_HARDWARE.md)
# -----------------------------------------------------------------------------
firmware/**/build/
firmware/**/.pio/
firmware/**/.vscode/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
firmware/**/dependencies.lock
firmware/**/secrets.h
firmware/**/wifi_config.h
.pio/
.pioenvs/
.piolibdeps/
sdkconfig
sdkconfig.old
secrets.h
wifi_config.h

# -----------------------------------------------------------------------------
# 8. Log dan berkas sementara proses
#    (log tidak boleh memuat JPEG, embedding, token, atau identitas)
# -----------------------------------------------------------------------------
*.log
logs/
log/
*.tmp
tmp/
temp/
.crash/
crashlytics-build.properties
*.pid
*.seed
*.pid.lock
*.lock
!package-lock.json
!pnpm-lock.yaml
!bun.lock
!bun.lockb
!go.sum
!poetry.lock
!requirements.lock

# Rekaman audio/video uji (dapat memuat wajah/suara peserta)
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
recordings/
screenshots/local/
artifacts/local/

# -----------------------------------------------------------------------------
# 9. Editor dan OS
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.stackdump

# -----------------------------------------------------------------------------
# 10. Alat AI coding agent (bersifat lokal, bukan bagian produk)
# -----------------------------------------------------------------------------
.omo/
.claude/
.codex/
.agent/
.aider*
.cursor/
*.aider.chat.history.md

# -----------------------------------------------------------------------------
# 11. Berkas hasil build dan arsip umum
# -----------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
dist/
out/
*.apk
*.aab
*.ipa
*.msi
*.dmg
*.AppImage
*.snap
*.deb
*.rpm

# -----------------------------------------------------------------------------
# 12. CATATAN PEMELIHARAAN
# -----------------------------------------------------------------------------
# - Jangan tambahkan pola yang mengabaikan `docs/`, `research/`, `*.md`,
#   `AGENTS.md`, `PROJECT_STATE.md`, `README.md`, atau source code.
# - Uji ulang dengan `git status --ignored` setelah menambah pola baru.
# - Data biometrik tidak selalu lenyap bersama berkasnya: SQLite WAL (`*.db-wal`,
#   `*.db-shm`) dan salinan cadangan dapat memuat sisa baris yang sudah dihapus.
#   Pola WAL/SHM ada di bagian 2 agar berkas itu tidak ikut ter-commit
#   (docs/SECURITY_PRIVACY.md §5c dan §5f).
# - Rahasia yang sudah terlanjur di-commit harus dianggap bocor: rotasi
#   kredensial, lalu bersihkan riwayat. Jangan mengandalkan penghapusan biasa.
