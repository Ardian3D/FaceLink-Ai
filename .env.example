# =============================================================================
# .env.example — FaceLink AI
# Tugas: FL-005 (Fondasi Backend Go)
#
# Berkas ini HANYA contoh. Salin menjadi `.env` lalu sesuaikan untuk mesin Anda:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux/macOS)
#
# JANGAN menulis kredensial nyata, token perangkat, atau kata sandi ke berkas
# ini. `.gitignore` mengabaikan `.env` dan seluruh `.env.*`, kecuali berkas
# contoh ini (lihat bagian 1 `.gitignore`).
#
# Backend TIDAK memuat `.env` secara otomatis. Variabel di bawah dibaca langsung
# dari lingkungan proses oleh `internal/config`. Untuk memuatnya, ekspor lebih
# dulu — misalnya di PowerShell:
#
#     Get-Content .env | Where-Object { $_ -match '^\s*[^#]' } | ForEach-Object {
#       $n, $v = $_ -split '=', 2
#       Set-Item -Path "Env:$($n.Trim())" -Value $v.Trim()
#     }
# =============================================================================

# -----------------------------------------------------------------------------
# Alamat mendengarkan
# WAJIB loopback (127.0.0.1 / localhost / ::1). Konfigurasi menolak alamat
# non-loopback agar mesin AI dan basis data tidak terbuka ke jaringan
# (AGENTS.md §2, docs/SECURITY_PRIVACY.md).
# Contoh: 127.0.0.1:8080
# -----------------------------------------------------------------------------
FACELINK_ADDR=127.0.0.1:8080

# -----------------------------------------------------------------------------
# Jalur basis data SQLite
# Direktori dibuat otomatis. Jangan letakkan di dalam folder sinkronisasi
# (OneDrive, Dropbox, Google Drive, iCloud) — konfigurasi akan menolaknya,
# karena sinkronisasi dapat merusak berkas WAL.
# -----------------------------------------------------------------------------
FACELINK_DB_PATH=data/facelink.db

# -----------------------------------------------------------------------------
# Direktori berkas migrasi SQL
# Relatif terhadap direktori kerja proses, atau absolut.
# -----------------------------------------------------------------------------
FACELINK_MIGRATIONS_DIR=migrations

# -----------------------------------------------------------------------------
# Alamat mesin AI lokal (Python, fase berikutnya)
# Kosongkan bila mesin AI belum dijalankan. Backend tetap siap melayani dan
# absensi manual tetap berjalan; `/readyz` akan melaporkan
# `"ai_engine": "unavailable"` (docs/SECURITY_PRIVACY.md §5e).
# Mesin AI hanya boleh mendengarkan di loopback.
# -----------------------------------------------------------------------------
FACELINK_AI_ENGINE_URL=

# -----------------------------------------------------------------------------
# Batas waktu (format durasi Go: 10s, 500ms, 1m)
# -----------------------------------------------------------------------------
FACELINK_READ_TIMEOUT=10s
FACELINK_WRITE_TIMEOUT=20s
FACELINK_IDLE_TIMEOUT=60s
FACELINK_SHUTDOWN_TIMEOUT=15s

# -----------------------------------------------------------------------------
# Tingkat log: debug | info | warn | error
# -----------------------------------------------------------------------------
FACELINK_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Label versi yang muncul pada /healthz dan log. Biarkan "dev" saat lokal.
# -----------------------------------------------------------------------------
FACELINK_BUILD_VERSION=dev

# -----------------------------------------------------------------------------
# HTTPS lokal (opsional). Isi KEDUANYA atau biarkan keduanya kosong.
# Hanya untuk build debug: CA dev tidak dipercaya build release.
# Jalankan scripts/gen-dev-tls.sh untuk membuat sertifikatnya.
# -----------------------------------------------------------------------------
FACELINK_TLS_CERT=
FACELINK_TLS_KEY=

# Email OTP (FL-OTP01/02). Backend tidak memuat .env otomatis.
# Semua kosong = OTP unavailable (503); konfigurasi parsial ditolak.
# HTTPS backend wajib. SMTP 465 implicit TLS / 587 STARTTLS wajib.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_AUTH_SECRET=
# FL-OTP02: support@facelink.online sudah ditambahkan sebagai "Send mail as".
# Isi domain alias di bawah HANYA jika alias benar-benar terverifikasi di Gmail.
# Tanpa allowlist, SMTP_FROM wajib sama dengan SMTP_USERNAME.
# Contoh: SMTP_FROM=support@facelink.online
#         SMTP_REPLY_TO=support@facelink.online
#         SMTP_ALLOWED_FROM_DOMAINS=facelink.online
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_ALLOWED_FROM_DOMAINS=
# Di luar Git; Windows: DPAPI CurrentUser, buat manual dengan scripts/new-otp-key.ps1.
# Linux/macOS: base64 key acak 32 byte dengan permission 600.
FACELINK_OTP_HMAC_KEY_FILE=
